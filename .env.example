# Database
DATABASE_URL=                        # PostgreSQL connection string. If absent, site runs in mock mode.

# Auth.js
AUTH_SECRET=                         # Generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000        # Full URL of the site (for Auth.js callbacks)

# Admin credentials (used by npm run db:seed)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me

# Contact form (Resend)
RESEND_API_KEY=                      # Get from resend.com dashboard
CONTACT_EMAIL=you@yourdomain.com     # Where contact form submissions are delivered
CONTACT_FROM_EMAIL=portfolio@yourdomain.com  # Must be a verified sender domain in Resend

# AI agents
ANTHROPIC_API_KEY=                   # Required for LLM summarization in agents
GITHUB_TOKEN=                        # Optional - increases GitHub API rate limits
GITHUB_USERNAME=                     # Your GitHub username (for the GitHub Summarizer agent)

# SEO / Public URL
NEXT_PUBLIC_BASE_URL=https://yourdomain.com  # Canonical site URL used in sitemap and JSON-LD schemas

# Cloudflare R2 file storage (optional - for media uploads in admin panel)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
