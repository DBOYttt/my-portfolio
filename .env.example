# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio_db"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Admin credentials (seed script uses these)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="change-this-before-production"

# Email (Resend)
RESEND_API_KEY="re_..."
CONTACT_FROM_EMAIL="portfolio@yourdomain.com"  # Must be a verified sender domain in Resend
CONTACT_EMAIL="you@yourdomain.com"             # Where contact form submissions are delivered

# AI Agents (choose one or both)
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# GitHub (for GitHub Summarizer agent)
GITHUB_TOKEN="ghp_..."
GITHUB_USERNAME="yourusername"

# Storage (Cloudflare R2 or local)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="portfolio-media"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# Public URL (used for SEO, OG images)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_BASE_URL=https://yourdomain.com  # Canonical site URL used in sitemap and JSON-LD schemas
